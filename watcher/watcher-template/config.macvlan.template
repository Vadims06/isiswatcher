name: {{watcher_folder_name}}
prefix: __lab-name

topology:
  defaults:
    env-files:
    - ../../.env
    labels:
      connection_mode: macvlan
      macvlan_parent_interface: {{macvlan_parent_interface}}
      macvlan_ip_w_mask_watcher: {{macvlan_ip_w_mask_watcher}}
      area_num: {{area_num}}
      asn: {{asn}}
      organisation_name: {{organisation_name}}
      watcher_name: {{watcher_name}}
      watcher_id: {{watcher_id}}
  nodes:
    isis-watcher:
      kind: linux
      image: {{image_watcher}}
      network-mode: container:router
      env:
        ASN: {{asn}}
        WATCHER_NAME: {{watcher_name}}
        AREA_NUM: {{area_num}}
        WATCHER_INTERFACE: eth1
        WATCHER_LOGFILE: /home/watcher/watcher/logs/watcher.log
        WATCHER_IP: {{macvlan_watcher_ip}}
{{#server}}
        TOPOLOGRAPH_HOST: {{topolograph_host}}
        TOPOLOGRAPH_PORT: {{topolograph_port}}
        TOPOLOGRAPH_API_TOKEN: {{watcher_token}}
{{/server}}
      binds:
      - ../logs/:/home/watcher/watcher/logs/
      - ../logs/{{watcher_folder_name}}.isis.log:/home/watcher/watcher/logs/watcher.log
      stages:
        create:
          wait-for:
          - node: receive_only_filter
            stage: exit
    logrotation:
      kind: linux
      # https://github.com/Vadims06/docker-logrotate
      image: {{image_logrotation}}
      env:
        LOGROTATE_FILE_PATTERN: '*.log'
        # don't rotate at all but truncate log, because only single log file is bind to this container
        LOGROTATE_ROTATE: '0'
        LOGROTATE_SIZE: 500M
        # once a day
        LOGROTATE_CRON: 0 0 * * *
      binds:
      - ../logs/{{watcher_folder_name}}.isis.log:/logs/watcher.log
    router:
      kind: linux
      image: {{image_router}}
      binds:
      - router/daemons:/etc/frr/daemons
      - router/frr.conf:/etc/frr/frr.conf
      - router/vtysh.conf:/etc/frr/vtysh.conf
      exec:
      # containerlab brings the macvlan up; it stays down until the filter is attached, so no filter means no adjacency
      - ip link set dev eth1 down
    receive_only_filter:
      kind: linux
      image: {{image_filter}}
      startup-delay: 2
      # in the FRR namespace: eth1 is there, and the host network stays out of reach
      network-mode: container:router
      # one-shot node: it attaches the announcement filter, brings eth1 up and exits, so it must not be restarted
      restart-policy: no
      env:
        FILTER_INTERFACE: eth1
        WATCHER_SYSTEM_ID: {{watcher_system_id}}
        TUNNEL_NETWORK: {{tunnel_network}}
        TUNNEL_PREFIX_LEN: '{{tunnel_prefix_len}}'
      stages:
        create:
          wait-for:
          - node: router
            stage: configure
  links:
  # private: two watchers on one parent interface never see each other
  - type: macvlan
    endpoint:
      node: router
      interface: eth1
    host-interface: {{macvlan_parent_interface}}
    mode: private
